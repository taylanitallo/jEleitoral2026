{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "isolatedModules": true,
    "paths": {
      "@jeleitoral/tipos": ["./pacotes/tipos/src/index.ts"],
      "@jeleitoral/tipos/*": ["./pacotes/tipos/src/*"],
      "@jeleitoral/utilitarios": ["./pacotes/utilitarios/src/index.ts"],
      "@jeleitoral/utilitarios/*": ["./pacotes/utilitarios/src/*"],
      "@jeleitoral/ui": ["./pacotes/ui/src/index.ts"],
      "@jeleitoral/ui/*": ["./pacotes/ui/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", ".next", "build"]
}
