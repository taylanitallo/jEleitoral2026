# =============================================================================
# jEleitoral — variáveis de ambiente
# Copie para `.env` e preencha. NUNCA versione o `.env` preenchido.
# =============================================================================

# --- Ambiente ---------------------------------------------------------------
# desenvolvimento | homologacao | producao
AMBIENTE=desenvolvimento
PORTA_API=3333
URL_WEB=http://localhost:3000

# --- Supabase ---------------------------------------------------------------
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Chave anônima: usada pelo frontend e como base do cliente por-requisição da API.
SUPABASE_CHAVE_ANONIMA=
# Chave de serviço: IGNORA RLS POR DESIGN.
# Uso permitido APENAS em jobs de ETL sobre tabelas de referência (IBGE/TSE),
# que não possuem `id_organizacao`. O teste `serviceRole.spec.ts` quebra o build
# se ela for usada em tabela multi-tenant.
SUPABASE_CHAVE_SERVICO=
# Segredo do JWT do projeto — valida os tokens recebidos pela API.
SUPABASE_JWT_SEGREDO=
# String de conexão direta (migrations e COPY em lote do ETL).
BANCO_URL=postgresql://postgres:senha@localhost:54322/postgres

# --- Criptografia de identificadores (LGPD) ---------------------------------
# Chave AES-256-GCM em hexadecimal (64 caracteres = 32 bytes).
# Gere com: openssl rand -hex 32
CHAVE_CRIPTOGRAFIA_AES=
# Segredo do HMAC-SHA256 usado para índice de busca sobre dado criptografado.
# Gere com: openssl rand -hex 32
SEGREDO_HMAC_INDICE=

# --- Redis / filas (Railway) ------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Anthropic (IA) ---------------------------------------------------------
# NUNCA exponha esta chave no frontend. Só o backend fala com a Anthropic.
ANTHROPIC_API_KEY=
IA_MODELO_PADRAO=claude-opus-5
IA_LIMITE_CREDITOS_MENSAL_PADRAO=100000

# --- Integrações externas ---------------------------------------------------
# User-Agent identificável — exigência de boa conduta com TSE e IBGE.
INTEGRACOES_USER_AGENT=jEleitoral/1.0 (+https://jeos.com.br; contato@jeos.com.br)
IBGE_URL_BASE=https://servicodados.ibge.gov.br/api/v1/localidades
BRASILAPI_URL_BASE=https://brasilapi.com.br/api
VIACEP_URL_BASE=https://viacep.com.br/ws
TSE_CKAN_URL_BASE=https://dadosabertos.tse.jus.br/api/3/action
DIVULGACAND_URL_BASE=https://divulgacandcontas.tse.jus.br/divulga/rest/v1
# Requisições por segundo no DivulgaCandContas (API não oficial — seja gentil).
DIVULGACAND_REQ_POR_SEGUNDO=1

# --- Apuração ao vivo (Fase 13) ---------------------------------------------
# Mantenha `false` fora da noite de apuração.
APURACAO_AO_VIVO_HABILITADA=false
APURACAO_URL_BASE=
APURACAO_INTERVALO_SEGUNDOS=60

# --- Observabilidade --------------------------------------------------------
SENTRY_DSN_API=
SENTRY_DSN_WEB=
NIVEL_LOG=info

# --- Frontend (expostas ao navegador — só coloque o que pode ser público) ----
NEXT_PUBLIC_URL_API=http://localhost:3333
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_CHAVE_ANONIMA=
