{
  "name": "jeleitoral",
  "version": "0.1.0",
  "private": true,
  "description": "jEleitoral — Sistema de Mapeamento, Projeção e Gestão Eleitoral (Eleições Gerais 2026)",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "preparar": "pnpm install",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:isolamento": "pnpm --filter @jeleitoral/api test:isolamento",
    "build": "pnpm -r --if-present build",
    "dev": "pnpm -r --parallel --if-present dev",
    "verificar:integracoes": "pnpm --filter @jeleitoral/api verificar:integracoes",
    "banco:migrar": "supabase db push --workdir infra/supabase",
    "banco:reset": "supabase db reset --workdir infra/supabase",
    "formatar": "prettier --write \"**/*.{ts,tsx,js,json,md,sql,yml,yaml}\"",
    "formatar:verificar": "prettier --check \"**/*.{ts,tsx,js,json,md,sql,yml,yaml}\""
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3",
    "next": "^14.2.35"
  }
}
