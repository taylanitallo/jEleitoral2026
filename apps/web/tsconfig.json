{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "preserve",
    "allowJs": true,
    "noEmit": true,
    "incremental": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@jeleitoral/tipos": [
        "../../pacotes/tipos/src/index.ts"
      ],
      "@jeleitoral/ui": [
        "../../pacotes/ui/src/index.ts"
      ],
      "@jeleitoral/utilitarios": [
        "../../pacotes/utilitarios/src/index.ts"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next-local/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
