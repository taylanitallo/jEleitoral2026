{
  "name": "@jeleitoral/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/construir.mjs --observar",
    "build": "node scripts/construir.mjs",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "_comentario_test": "Só testes unitários. Os de `testes/` exigem PostgreSQL real e rodam no job `banco` do CI, por `test:rls` e `test:isolamento` — falhar por falta de banco no lint não ajuda ninguém, e fazê-los passar sem banco seria pior.",
    "test": "vitest run src --passWithNoTests",
    "banco:aplicar": "tsx scripts/aplicarMigrations.ts",
    "test:rls": "vitest run testes/coberturaRls.spec.ts",
    "test:isolamento": "vitest run testes/isolamento.spec.ts",
    "verificar:integracoes": "tsx scripts/verificarIntegracoes.ts",
    "ibge:sincronizar": "tsx scripts/sincronizarIbge.ts"
  },
  "dependencies": {
    "@jeleitoral/tipos": "workspace:*",
    "@jeleitoral/utilitarios": "workspace:*",
    "@nestjs/common": "^10.4.4",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.4",
    "@nestjs/platform-express": "^10.4.4",
    "@nestjs/throttler": "^6.2.1",
    "@supabase/supabase-js": "^2.45.4",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.0.0",
    "jose": "^5.9.3",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8",
    "@anthropic-ai/sdk": "^0.115.0",
    "exceljs": "^4.4.0",
    "pdfkit": "^0.15.1",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/testing": "^10.4.4",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.5",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3",
    "@types/pdfkit": "^0.13.5",
    "esbuild": "^0.24.0",
    "esbuild-plugin-tsc": "^0.5.0"
  }
}
