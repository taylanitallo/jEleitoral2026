# dependências
node_modules/
.pnpm-store/

# builds
dist/
build/
.next/
.next-local/
# Qualquer diretorio de build do Next, inclusive os criados ad hoc com
# NEXT_DIRETORIO_BUILD. Sem o coringa, um diretorio novo entra no commit.
.next-*/
out/
*.tsbuildinfo

# ambiente — NUNCA versionar segredos
.env
.env.*
!.env.exemplo

# Configuração de sessão do Claude Code. Fora do versionamento por inteiro:
# o allowlist de permissões registra comandos executados e já capturou uma
# senha de banco uma vez. Repositório público não é lugar para esse risco.
.claude/

# supabase local
infra/supabase/.temp/
supabase/.temp/
supabase/.branches/
infra/supabase/.branches/

# dados baixados pelos ETLs (podem ter dezenas de GB)
infra/etl/dados/
*.zip
*.csv.gz

# logs e cobertura
*.log
npm-debug.log*
coverage/
.nyc_output/
playwright-report/
test-results/

# editores / SO
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

.vercel
